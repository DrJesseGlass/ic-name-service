// ic-name-service, milestone M0 (resolve). See DESIGN.md.
//
// Certified resolution: `resolve` returns the subnet certificate over this
// canister's certified data and a CBOR hash tree witness. The tree is
// labeled "names"; under it each scoped name is a leaf whose bytes are the
// record's canonical form:
//
//   name=<name>\n
//   owner=<principal>\n
//   target=address:<principal>\n        or   target=alias:<name>\n
//   text.<key>=<value>\n                (one per text record, sorted by key)
//   created_ns=<u64>\n
//   updated_ns=<u64>\n
//   changed_hands_ns=<u64>\n
//
// A verifier checks the certificate against the IC root key, reads
// /canister/<id>/certified_data from it, checks it equals the witness root,
// then checks the leaf for each name in `chain` equals that record's
// canonical form.

type Target = variant {
  address : principal;
  alias : text;
};

// Harberger state of a flat name (DESIGN.md section 5), cycles. balance
// is as of settled_ns; the canister settles lazily on every read and write.
type Harberger = record {
  price : nat;
  balance : nat;
  settled_ns : nat64;
  lapsed_ns : opt nat64;
};

type Record = record {
  name : text;
  owner : principal;
  target : Target;
  "text" : vec record { text; text };
  created_ns : nat64;
  updated_ns : nat64;
  changed_hands_ns : nat64;
  // Present on flat names only. Adds four lines to the canonical form:
  //   price=<nat>\n balance=<nat>\n settled_ns=<u64>\n lapsed_ns=<u64 or 0>\n
  flat : opt Harberger;
  // What the name pointed at before it last changed hands. Adds one line:
  //   previous_target=address:<principal>\n  or  previous_target=alias:<name>\n
  previous_target : opt Target;
};

type Resolved = record {
  name : text;
  canister : principal;
  chain : vec Record;
  certificate : opt blob;
  witness : blob;
};

type Handle = record {
  owner : principal;
  // A listed deployer the owner lets announce under this handle.
  deployer : opt principal;
};

// What a deployer reports after a successful install (ic-git's
// DeployRecord: commit, target, wasm_sha256). Trusted by caller principal.
type Announcement = record {
  name : text;
  canister : principal;
  repo : text;
  commit : text;
  module_hash : text;
};

type HttpRequest = record {
  method : text;
  url : text;
  headers : vec record { text; text };
  body : blob;
};

type HttpResponse = record {
  status_code : nat16;
  headers : vec record { text; text };
  body : blob;
  upgrade : opt bool;
};

// Directory (DESIGN.md section 7). Tags come from the "tags" text record:
// comma separated, no spaces, each tag in the handle grammar.
type SearchQuery = record {
  q : opt text;        // case-insensitive substring of name or description
  tag : opt text;      // only names carrying this tag
  offset : opt nat32;
  limit : opt nat32;   // at most 100; 20 when absent
};

type Hit = record {
  name : text;
  target : Target;
  description : opt text;
  tags : vec text;
  repo : opt text;
  commit : opt text;
  module_hash : opt text;
  updated_ns : nat64;
};

type SearchResult = record {
  total : nat32;       // matches before paging
  offset : nat32;
  hits : vec Hit;
};

type TagCount = record { tag : text; count : nat32 };

type Status = variant {
  active;
  grace : record { until_ns : nat64 };  // balance gone; owner keeps it until then
  free;                                 // up for auction
};

type FlatStatus = record {
  name : text;
  owner : principal;
  target : Target;
  price : nat;
  balance : nat;         // settled to now
  status : Status;
  tax_per_year : nat;
  min_deposit : nat;     // least deposit for a buy at this price
  changed_hands_ns : nat64;
};

type HarbergerConfig = record {
  ledger : principal;    // the cycles ledger (ICRC-2); changeable only while nothing is held
  rate_bps : nat32;      // tax per year on the price, basis points
  min_price : nat;       // cycles
  grace_ns : nat64;
  fee : nat;             // the ledger's transfer fee as it answered when set; pinned on transfers
  flat_names_open : bool;    // new bids allowed; false by default; buy, reveal, close never gated
  handover_warn_ns : nat64;  // gateway shows a warning page this long after a sale
};

type Expiring = record {
  name : text;
  owner : principal;
  status : Status;
  deadline_ns : nat64;   // balance runs out (active) or grace ends (grace)
  balance : nat;         // settled to now
  tax_per_year : nat;
};

// Sealed-bid second-price auctions for free flat names (never held,
// released, or lapsed past grace). The first bid opens one; phases are
// fixed when it opens.
type AuctionConfig = record {
  commit_ns : nat64;     // commit phase, from the first commitment
  reveal_ns : nat64;     // reveal phase, after it
  reserve : nat;         // least a winner pays; min_price applies too (the larger wins)
};

type Phase = variant { commit; reveal; closed };

type AuctionView = record {
  name : text;
  phase : Phase;
  opened_ns : nat64;
  commit_until_ns : nat64;
  reveal_until_ns : nat64;
  reserve : nat;
  bidders : vec principal;   // every commitment, in order
  revealed : nat32;
  winner : opt principal;    // once ended: who close_auction makes the holder
  price : opt nat;           // and what they pay
};

type Closed = record {
  winner : opt principal;
  price : nat;           // second-highest revealed bid, or the reserve; 0 if nobody won
  assessed : nat;        // the winner's own bid, their Harberger price from here on
  forfeited : nat;       // deposits of unrevealed commitments
};

type Treasury = record {
  collected : nat;       // tax settled plus auction proceeds
  withdrawn : nat;
  auctioned : nat;       // the part of collected from auction prices and forfeits
  escrowed : nat;        // deposits held in auctions not yet closed
  // cycles whose movement a ledger reply left unconfirmed; never spent
  unreconciled : nat;
  unreconciled_last : text;
};

type Result = variant { Ok; Err : text };
type ResolveResult = variant { Ok : Resolved; Err : text };
type NatResult = variant { Ok : nat; Err : text };
type CloseResult = variant { Ok : Closed; Err : text };

service : {
  // handles: <handle> in <handle>/<label>; free, permanent, first come
  register_handle : (text) -> (Result);
  handle_owner : (text) -> (opt principal) query;
  get_handle : (text) -> (opt Handle) query;
  set_handle_deployer : (text, opt principal) -> (Result);

  // records, owner only
  set_record : (text, Target) -> (Result);
  set_text : (text, text, opt text) -> (Result);
  delete_record : (text) -> (Result);

  // reads
  get_record : (text) -> (opt Record) query;
  list_names : (text) -> (vec text) query;
  resolve : (text) -> (ResolveResult) query;

  // flat names (DESIGN.md section 5). Payments are ICRC-2 pulls from the
  // caller's cycles ledger account: approve this canister first.
  buy : (text, text, nat, nat, nat) -> (Result);   // name, alias_to, price, deposit, max_price
  deposit : (text, nat) -> (Result);               // name, amount
  set_price : (text, nat) -> (Result);
  flat_status : (text) -> (opt FlatStatus) query;
  expiring : (nat64) -> (vec Expiring) query;      // within this many ns of now
  credit : (principal) -> (nat) query;             // sale proceeds and refunds owed
  withdraw : (nat) -> (NatResult);                 // credit -> caller's ledger account
  treasury : () -> (Treasury) query;
  fund_self : (nat) -> (NatResult);                // controllers: tax -> own cycles
  // controllers; reads the fee from the ledger, settles all names before a
  // rate change, refuses a ledger change while funds are held
  set_harberger_config : (HarbergerConfig) -> (Result);
  harberger_config : () -> (HarbergerConfig) query;

  // auctions for free flat names. bid needs the market open; reveal and
  // close never do. The winner assesses at their bid, pays the second
  // price, and starts with one grace period of tax as balance; the rest of
  // every deposit is credited. An unrevealed commitment forfeits.
  bid : (text, blob, nat) -> (Result);             // name, commitment (32 bytes), deposit
  reveal : (text, nat, blob, text) -> (Result);    // name, amount, salt, alias_to
  close_auction : (text) -> (CloseResult);         // anyone, after the reveal phase
  auction_status : (text) -> (opt AuctionView) query;
  auctions : () -> (vec AuctionView) query;
  // sha256("ic-auction/vickrey/v1" || u64be len || bidder bytes ||
  // u128be amount || u64be len || salt). Tests only: asking sends your bid.
  auction_commitment : (principal, nat, blob) -> (blob) query;
  set_auction_config : (AuctionConfig) -> (Result);  // controllers
  auction_config : () -> (AuctionConfig) query;

  // directory
  search : (SearchQuery) -> (SearchResult) query;
  tags : () -> (vec TagCount) query;
  // stable memory layout version (store.rs SCHEMA); migrations key on it
  schema_version : () -> (nat32) query;

  // custom domains served at /.well-known/ic-domains (controllers)
  set_domains : (vec text) -> (Result);
  domains : () -> (vec text) query;

  // deployers: controllers list them; a listed deployer may announce
  add_deployer : (principal) -> (Result);
  remove_deployer : (principal) -> (Result);
  list_deployers : () -> (vec principal) query;
  announce : (Announcement) -> (Result);

  // stage 1 gateway, every response certified with a skip-certification
  // expression: /<name> -> 302 (or a warning page after a sale);
  // /api/resolve/<name>, /api/search, /api/tags, /api/expiring -> JSON;
  // /.well-known/ic-domains -> text
  http_request : (HttpRequest) -> (HttpResponse) query;
}
